*
!.gitignore

# keep canteen-checkout
!canteen-checkout/
!canteen-checkout/**
canteen-checkout/runs/
canteen-checkout/*.pt
canteen-checkout/**/*.pt
canteen-checkout/*.pth
canteen-checkout/**/*.pth

# but not dependencies, builds or caches
canteen-checkout/node_modules/
canteen-checkout/.next/
canteen-checkout/dist/
canteen-checkout/build/
canteen-checkout/.venv/
canteen-checkout/venv/
canteen-checkout/__pycache__/
canteen-checkout/**/*.pyc
canteen-checkout/.DS_Store

!colab-upload/

colab-upload/*
!colab-upload/*.ipynb
EOF
